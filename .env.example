# BugFlow Environment Configuration Template
# Copy this file to .env in backend/ directory for local setup.
# NEVER commit actual secret keys or API credentials to source control.

FLASK_ENV=development
SECRET_KEY=your_flask_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
DATABASE_URL=sqlite:///bugflow.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# AI Feature Integration (Google Gemini API Key)
# Required for RAG Resolution Assistance, Semantic Embeddings & Vision Screenshot Analysis
GEMINI_API_KEY=your_gemini_api_key_here
